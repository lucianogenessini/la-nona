---
interface Props {
  stem: string;
  caption: string;
  class?: string;
  eager?: boolean;
}

const { stem, caption, eager = false, class: className = "" } = Astro.props;
---

<figure class:list={["reel", className]} data-reel>
  <div class="reel-frame">
    <img
      class="reel-poster"
      src={`/video/${stem}-poster.jpg`}
      alt={caption}
      width="1280"
      height="720"
      loading={eager ? "eager" : "lazy"}
    />
    <video
      class="reel-video"
      muted
      loop
      playsinline
      preload={eager ? "metadata" : "none"}
      poster={`/video/${stem}-poster.jpg`}
    >
      <source src={`/video/${stem}.webm`} type="video/webm" />
      <source src={`/video/${stem}.mp4`} type="video/mp4" />
    </video>
  </div>
</figure>
