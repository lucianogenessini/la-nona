---
import "../styles/site.css";

const site = "https://textillanona.com.ar";
const title = "Textil La Nona | Trapos de piso y recarga de urdido en Misiones";
const description =
  "Textil La Nona fabrica trapos de piso de algodón y recarga carreteles de urdido (12/2 y 8/1, 70 cm y 100 cm) para empresas textiles. Fabricación nacional en Leandro N. Alem, Misiones.";
const ogImage = `${site}/img/trapo.webp`;
const canonical = `${site}/`;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="trapos de piso, recarga de urdido, carreteles, textil, Misiones, Leandro N. Alem, algodón, Textil La Nona, urdido 12/2, urdido 8/1"
    />
    <meta name="author" content="Textil La Nona" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/webp" href="/img/logo-mark.webp" />
    <link rel="apple-touch-icon" href="/img/logo-mark.webp" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Trapos de piso de algodón de Textil La Nona" />
    <meta property="og:site_name" content="Textil La Nona" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Nunito:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": ["Organization", "LocalBusiness", "TextileFactory"],
          "@id": `${site}/#org`,
          "name": "Textil La Nona",
          "url": site,
          "logo": `${site}/img/logo-mark.webp`,
          "image": [
            `${site}/img/trapo.webp`,
            `${site}/img/trapo-color.webp`,
            `${site}/img/urdido.webp`,
            `${site}/img/carretel.webp`
          ],
          "telephone": "+543754434100",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Independencia 175",
            "addressLocality": "Leandro N. Alem",
            "addressRegion": "Misiones",
            "addressCountry": "AR"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": -27.6033,
            "longitude": -55.3236
          },
          "areaServed": { "@type": "AdministrativeArea", "name": "Misiones, Argentina" },
          "description": description,
          "sameAs": [],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+543754434100",
            "contactType": "sales",
            "availableLanguage": ["Spanish"]
          }
        },
        {
          "@type": "WebSite",
          "@id": `${site}/#website`,
          "url": site,
          "name": "Textil La Nona",
          "publisher": { "@id": `${site}/#org` },
          "inLanguage": "es-AR"
        }
      ]
    })} />
  </head>
  <body>
    <a class="skip" href="#inicio">Saltar al contenido</a>
    <svg class="visually-hidden" width="0" height="0" aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden">
      <symbol id="wa" viewBox="0 0 24 24">
        <path
          fill="currentColor"
          d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.79.5 3.48 1.39 4.94L2 22l5.31-1.38c1.41.83 3.04 1.28 4.73 1.28h.01c5.46 0 9.91-4.45 9.91-9.91s-4.45-9.91-9.91-9.91zm0 18.26h-.01c-1.48 0-2.92-.41-4.2-1.19l-.3-.18-3.12.81.83-3.04-.2-.32c-.85-1.35-1.3-2.9-1.3-4.52 0-4.59 3.73-8.32 8.32-8.32 4.59 0 8.32 3.73 8.32 8.32 0 4.59-3.73 8.32-8.32 8.32zm4.53-6.23c-.25-.12-1.47-.72-1.7-.81-.23-.09-.39-.12-.56.12-.17.25-.64.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.66-1.22-1.48-1.36-1.73-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.76 2.68 4.27 3.77 2.51 1.08 2.51.72 2.96.69.45-.03 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.07-.1-.23-.16-.48-.28z"
        />
      </symbol>
    </svg>
    <slot />
    <script src="../scripts/home.ts"></script>
  </body>
</html>
